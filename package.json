{
  "name": "jawad-portfolio",
  "private": true,
  "description": "J.Pixels — portfolio of Jawad Hussain, graphic designer.",
  "scripts": {
    "css": "tailwindcss -c tailwind.config.js -i assets/css/tailwind-input.css -o assets/css/tailwind.css --minify",
